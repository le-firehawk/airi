diff --git a/dist/runtime-browser.mjs b/dist/runtime-browser.mjs
new file mode 100644
--- /dev/null
+++ b/dist/runtime-browser.mjs
@@ -0,0 +1,13 @@
+import { selectBundle } from "@duckdb/duckdb-wasm";
+import { getBundles } from "./bundles/default-browser.mjs";
+
+async function getEnvironment() {
+	return "browser";
+}
+
+async function createWorker(opts) {
+	const bundle = await selectBundle(await (typeof opts.bundles === "undefined" ? getBundles() : opts.bundles));
+	return { worker: new Worker(bundle.mainWorker), bundle };
+}
+
+export { createWorker, getEnvironment };
diff --git a/dist/runtime-node.mjs b/dist/runtime-node.mjs
new file mode 100644
--- /dev/null
+++ b/dist/runtime-node.mjs
@@ -0,0 +1,38 @@
+import { selectBundle } from "@duckdb/duckdb-wasm";
+
+async function getEnvironment() {
+	if (typeof window !== "undefined" && window !== null) return "browser";
+	try {
+		const process = await import("node:process");
+		if (typeof process !== "undefined" && process.versions != null && process.versions.node != null) return "node";
+		return "unknown";
+	} catch {
+		return "unknown";
+	}
+}
+
+async function createWorker(opts) {
+	let worker;
+	let bundle;
+	const env = await getEnvironment();
+	if (env === "browser") {
+		if (typeof opts.bundles === "undefined") {
+			const { getBundles } = await import("./bundles/default-browser.mjs");
+			opts.bundles = await getBundles();
+		}
+		bundle = await selectBundle(await opts.bundles);
+		worker = new Worker(bundle.mainWorker);
+	} else if (env === "node") {
+		if (typeof opts.bundles === "undefined") {
+			const { getBundles } = await import("./bundles/default-node.mjs");
+			opts.bundles = await getBundles();
+		}
+		bundle = await selectBundle(await opts.bundles);
+		let workerUrl = bundle.mainWorker;
+		if (workerUrl.startsWith("/@fs/")) workerUrl = workerUrl.replace("/@fs/", "file://");
+		worker = new (await (import("web-worker"))).default(workerUrl, { type: "module" });
+	} else throw new Error(`Unsupported environment: ${env}`);
+	return { worker, bundle };
+}
+
+export { createWorker, getEnvironment };
