{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"]
    },
    "@proj-airi/electron-vueuse#build": {
      "dependsOn": ["@proj-airi/electron-eventa#build"],
      "outputs": ["dist/**"]
    },
    "@proj-airi/stage-ui#build": {
      "outputs": []
    },
    "@proj-airi/ui-loading-screens#build": {
      "outputs": []
    },
    "@proj-airi/ui-transitions#build": {
      "outputs": []
    },
    "@proj-airi/api-server#build": {
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
